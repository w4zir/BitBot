# Copy to `.env` and adjust. Docker-first URLs for Compose and in-container runs.
# For scripts on your machine, copy `.env.local.example` to `.env.local` (overrides).

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecom_support
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme

# Elasticsearch (policy retrieval — see README)
ES_HOST=elasticsearch
ES_PORT=9200
ES_SCHEME=http
ES_POLICY_INDEX=policy_docs
ES_TIMEOUT_SECONDS=5

# ModernBERT classifier (BentoML container)
CLASSIFIER_BENTOML_URL=http://modernbert:3000/classify
CLASSIFIER_BENTOML_TIMEOUT_SECONDS=5
MODERNBERT_MODELS_HOST_DIR=./training/models
MODERNBERT_MODELS_CONTAINER_DIR=/training/models
# Local HF eval default for testing/scripts/evaluate_modernbert_category.py (--model-dir)
MODERNBERT_MODEL_DIR=/training/models/bitext_multiclass_finetuned_20260415T120000Z/winner

# App
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501

# Frontend / tools (in-network from Compose; use `.env.local` for host Streamlit)
BACKEND_BASE_URL=http://backend:8000

# Session + required-fields config (full_flow on POST /classify)
# ISSUE_REQUIRED_FIELDS_PATH=/app/backend/config/issue_required_fields.json
# PROCEDURES_DIR=/app/backend/procedures
CATEGORY_CONFIDENCE_THRESHOLD=0.5
AGENT_VALIDATION_MAX_USER_WAITS=5
AGENT_MAX_NODE_TURNS=20
AGENT_CHECKPOINT_DB=agent_checkpoints.db
AGENT_PERSISTENT_MODE=0

# Simulator (in-network; use `.env.local` when running the runner on the host)
SIMULATOR_AGENT_URL=http://backend:8000/classify
SIMULATOR_USER_LLM_PROVIDER=ollama
SIMULATOR_USER_LLM_MODEL=llama3.2
SIMULATOR_USER_LLM_TIMEOUT_SECONDS=120
# LLM judge settings
SIMULATOR_LLM_PROVIDER=ollama
SIMULATOR_LLM_MODEL=gemma4:e4b
SIMULATOR_LLM_TIMEOUT_SECONDS=120
SIMULATOR_SUITE_PATH=testing/simulator/suites/smoke.yaml
SIMULATOR_ITERATIONS=1
SIMULATOR_EXTRA_ARGS=

# LLM — no_issue branch (Ollama or Cerebras)
NO_ISSUE_MODEL_PROVIDER=ollama
NO_ISSUE_MODEL=gemma4:e4b
# NO_ISSUE_SYSTEM_PROMPT=You are a helpful assistant...

# LLM — intent classification (scoped JSON intent; optional DB allowlist per category)
INTENT_MODEL_PROVIDER=ollama
INTENT_MODEL=gemma4:e4b

# LLM — validation branch
VALIDATION_MODEL_PROVIDER=ollama
VALIDATION_MODEL=gemma4:e4b

# LLM — policy constraint extraction (`scripts/extract_policy_constraints.py`)
# Falls back to LLM_PROVIDER / OLLAMA_MODEL (or VLLM_MODEL / CEREBRAS_MODEL by provider).
POLICY_CONSTRAINTS_MODEL_PROVIDER=ollama
POLICY_CONSTRAINTS_MODEL=llama3.2

# Ollama from containers (Docker Desktop). Linux: add extra_hosts if needed.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Cerebras (cloud) — only if provider is cerebras
# CEREBRAS_API_KEY=
# CEREBRAS_API_BASE=https://api.cerebras.ai/v1
CEREBRAS_TEMPERATURE=0.2

# vLLM (OpenAI-compatible server). Used when *_MODEL_PROVIDER / SIMULATOR_*_PROVIDER is vllm.
# In Docker Compose, backend talks to the `vllm` service; map host port with VLLM_HOST_PORT (default 8001).
VLLM_API_BASE=http://vllm:8000/v1
# VLLM_API_BASE=http://localhost:8001/v1
VLLM_API_KEY=
VLLM_TEMPERATURE=0.2
VLLM_HOST_PORT=8001
# HuggingFace model id loaded by the vllm container (required for docker compose up)
VLLM_MODEL=google/gemma-4-E4B-it
# Short name clients use in *_MODEL / SIMULATOR_*_MODEL (must match --served-model-name)
VLLM_SERVED_NAME=gemma4:e4b
# Optional: set to qwen3 when serving Qwen3 models
# VLLM_REASONING_PARSER=qwen3
VLLM_MAX_MODEL_LEN=512
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_NUM_SEQS=1
# Required for Gemma (gated model): create a token at huggingface.co/settings/tokens
# and accept the license at huggingface.co/google/gemma-4-E4B-it
# HF_TOKEN=

# Training/data scripts
# LLM_PROVIDER=ollama
# LLM_PROVIDER=vllm
# OLLAMA_MODEL=llama3.2
# VLLM_MODEL=your-org/your-model
# VLLM_API_BASE=http://localhost:8000/v1
# CEREBRAS_MODEL=llama3.1-8b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# OLLAMA_API_KEY=ollama

# LLM_HTTP_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=120
